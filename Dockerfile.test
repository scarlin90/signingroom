FROM node:26-bookworm@sha256:0353e48e0e8a993db87b720c242f54b207059d1bcc0106534896e8a11054c837

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Install Playwright Chromium browser AND its required OS system dependencies
RUN npx playwright install chromium --with-deps

# Copy source code
COPY . .

RUN mkdir -p apps/worker && \
    echo "ALLOWED_ORIGIN=http://localhost:4200" > apps/worker/.dev.vars && \
    echo "ENVIRONMENT=development" >> apps/worker/.dev.vars && \
    echo "API_PUBLIC_URL=http://127.0.0.1:8787" >> apps/worker/.dev.vars

# Strip Windows CRLF line endings and set permissions
RUN sed -i 's/\r$//' run-all-tests.sh
RUN chmod +x run-all-tests.sh

# Run the consolidated test script
CMD ["./run-all-tests.sh"]