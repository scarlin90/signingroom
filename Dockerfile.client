# Stage 1: Build & Bundle Angular SPA
FROM node:26-bookworm-slim AS builder

WORKDIR /app

ARG BUILD_ENV=development

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

RUN npx nx build client -c=${BUILD_ENV}

# Stage 2: Hardened Unprivileged Web Server
FROM nginxinc/nginx-unprivileged:alpine-slim

# Copy compiled Angular static assets (targeting the inner browser folder)
COPY --from=builder /app/dist/apps/client/browser/ /usr/share/nginx/html/

# Copy custom SPA Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]