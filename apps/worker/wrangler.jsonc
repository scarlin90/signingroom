{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signingroom",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [ "nodejs_compat" ],
  "vars": {
    "ALLOWED_ORIGIN": "https://signingroom.io",
    "API_PUBLIC_URL": "https://api.signingroom.io",
    "ENVIRONMENT": "production"
  },
  "routes": [
    {
      "pattern": "api.signingroom.io",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SIGNING_ROOM", "class_name": "SigningRoom" },
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "SigningRoom",
        "SalesCounter"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": ["SalesCounter"]
    }
  ],
  "kv_namespaces": [],
  "observability": { "enabled": true }
}