{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "signingroom",
	"main": "src/index.ts",
	"compatibility_date": "2024-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"ALLOWED_ORIGIN": "https://signingroom.io",
		"API_PUBLIC_URL": "https://api.signingroom.io",
		"ENVIRONMENT": "production",
	},
	"routes": [
		{
			"pattern": "api.signingroom.io",
			"custom_domain": true,
		},
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 300, "period": 60 },
		},
	],
	"durable_objects": {
		"bindings": [{ "name": "SIGNING_ROOM", "class_name": "SigningRoom" }],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["SigningRoom", "SalesCounter"],
		},
		{
			"tag": "v2",
			"deleted_classes": ["SalesCounter"],
		},
	],
	"env": {
		"development": {
			"name": "signingroom-dev",

			"routes": [
				{
					"pattern": "api-dev.signingroom.io",
					"custom_domain": true,
				},
			],

			"vars": {
				"ALLOWED_ORIGIN": "https://dev.signingroom.io",
				"API_PUBLIC_URL": "https://api-dev.signingroom.io",
				"ENVIRONMENT": "development",
			},
			"durable_objects": {
				"bindings": [{ "name": "SIGNING_ROOM", "class_name": "SigningRoom" }],
			},
			"ratelimits": [
				{
					"name": "RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 300, "period": 60 },
				},
			],
			"kv_namespaces": [],
		},
		"staging": {
			"name": "signingroom-staging",
			"routes": [{ "pattern": "api-staging.signingroom.io", "custom_domain": true }],
			"vars": {
				"ALLOWED_ORIGIN": "https://staging.signingroom.io",
				"API_PUBLIC_URL": "https://api-staging.signingroom.io",
				"ENVIRONMENT": "staging",
			},
			"durable_objects": {
				"bindings": [{ "name": "SIGNING_ROOM", "class_name": "SigningRoom" }],
			},
			"ratelimits": [
				{
					"name": "RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 300, "period": 60 },
				},
			],
			"kv_namespaces": [],
		},
	},
	"kv_namespaces": [],
	"observability": { "enabled": true },
}
