{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/client/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/client",
        "browser": "apps/client/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/client/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/client/public"
          },
          "apps/client/src/assets"
        ],
        "styles": ["apps/client/src/styles.css"],
        "server": "apps/client/src/main.server.ts",
        "ssr": {
          "entry": "apps/client/src/server.ts"
        },
        "prerender": true
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/client/ngsw-config.json"
        },
        "hosted-dev": {
          "optimization": true,
          "extractLicenses": false,
          "sourceMap": true,
          "outputHashing": "all",
          "serviceWorker": "apps/client/ngsw-config.json",
          "prerender": false,
          "ssr": false,
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.hosted-dev.ts"
            }
          ]
        },
        "hosted-staging": {
          "optimization": true,
          "extractLicenses": false,
          "sourceMap": true,
          "outputHashing": "all",
          "serviceWorker": "apps/client/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.hosted-staging.ts"
            }
          ]
        },
        "hosted-staging-branded": {
          "optimization": true,
          "extractLicenses": false,
          "sourceMap": true,
          "outputHashing": "all",
          "prerender": false,
          "ssr": false,
          "serviceWorker": "apps/client/ngsw-config.json",
          "index": {
            "input": "apps/client/src/index.branded.html",
            "output": "index.html"
          },
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.hosted-staging-branded.ts"
            }
          ]
        },
        "branded": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "prerender": false,
          "ssr": false,
          "index": {
            "input": "apps/client/src/index.branded.html",
            "output": "index.html"
          },
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.branded.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "prerender": false,
          "ssr": false
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "client:build:production"
        },
        "development": {
          "buildTarget": "client:build:development"
        },
        "branded": {
          "buildTarget": "client:build:branded"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "client:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/apps/client"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "client:build",
        "port": 4200,
        "staticFilePath": "dist/apps/client/browser",
        "spa": true
      }
    }
  }
}
