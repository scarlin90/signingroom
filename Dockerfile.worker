# Stage 1: Build & Bundle Worker
FROM node:26-bookworm-slim AS builder

WORKDIR /app

# Install ca-certificates so the cert bundle is guaranteed to exist
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY apps/worker/package*.json ./apps/worker/

RUN npm ci --legacy-peer-deps

COPY . .

# Compile the worker bundle using wrangler dry-run
RUN npx wrangler deploy --dry-run --outdir /app/dist --config apps/worker/wrangler.jsonc

# Stage 2: Minimalist Zero-CVE Runtime
FROM busybox:glibc

WORKDIR /worker

# Copy ca-certificates for networking support
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Copy the precompiled workerd binary directly from the node_modules installed in the builder stage
COPY --from=builder /app/node_modules/@cloudflare/workerd-linux-64/bin/workerd /worker/workerd-bin
RUN chmod +x /worker/workerd-bin

# Copy the compiled output bundle and universal capnp configuration
COPY --from=builder /app/dist/index.js /worker/index.js
COPY apps/worker/worker.capnp /worker/worker.capnp

EXPOSE 8787

ENTRYPOINT ["/worker/workerd-bin"]
CMD ["serve", "worker.capnp"]