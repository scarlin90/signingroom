# Stage 1: Build & Bundle Worker
FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS builder

WORKDIR /app

# Upgrade base packages and install ca-certificates
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY apps/worker/package*.json ./apps/worker/

# Install root dependencies
RUN npm ci --legacy-peer-deps

# Install worker-specific dependencies
RUN cd apps/worker && npm ci --legacy-peer-deps

COPY . .

# Compile the worker bundle using wrangler dry-run
RUN npx wrangler deploy --dry-run --outdir /app/dist --config apps/worker/wrangler.jsonc

# Stage 2: Hardened Distroless
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:08476c244888bfb425bae1ae4dd7c17f093e972aab8426883d97f3c6f280f7c1

WORKDIR /worker

# Copy ca-certificates for networking support
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Copy the workerd binary directly from builder stage
COPY --from=builder /app/node_modules/@cloudflare/workerd-linux-64/bin/workerd /worker/workerd-bin

# Copy the compiled output bundle and universal capnp configuration
COPY --from=builder /app/dist/index.js /worker/index.js
COPY apps/worker/worker.capnp /worker/worker.capnp

EXPOSE 8787

ENTRYPOINT ["/worker/workerd-bin"]
CMD ["serve", "worker.capnp"]